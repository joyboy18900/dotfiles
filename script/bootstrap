#!/usr/bin/env bash
set -e

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

link_file() {
    local src="$1" dst="$2"
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then return; fi
    if [ -f "$dst" ] || [ -d "$dst" ] || [ -L "$dst" ]; then
        mv "$dst" "${dst}.backup"
    fi
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    echo "linked: $dst → $src"
}

install_homebrew() {
    command -v brew &>/dev/null && return
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
}

install_deps() {
    local brewfile="$DOTFILES_ROOT/homebrew/Brewfile"
    [ -f "$brewfile" ] && brew bundle --adopt --file="$brewfile" || echo "Warning: some brew packages could not be installed, continuing…"
}

# Runs a command only if its tool is on PATH, and never lets its failure
# abort the rest of bootstrap. Every optional install step goes through
# this one place instead of repeating the guard itself.
run_if_available() {
    local tool="$1" description="$2"
    shift 2
    command -v "$tool" &>/dev/null || return 0
    "$@" || echo "Warning: $description failed, continuing…"
}

install_npm_globals() {
    run_if_available npm "npm global install" npm install -g @deepseek-ai/dsh @anthropic-ai/claude-code
}

install_uv_tools() {
    run_if_available uv "uv tool install" uv tool install git+https://github.com/github/spec-kit.git
}

install_antigravity() {
    command -v agy &>/dev/null && return 0
    run_if_available curl "antigravity CLI install" bash -c 'curl -fsSL https://antigravity.google/cli/install.sh | bash'
}

create_symlinks() {
    find "$DOTFILES_ROOT" -name "*.symlink" | while read -r src; do
        topic="$(basename "$(dirname "$src")")"
        filename="$(basename "$src" .symlink)"
        if [ "$topic" = "fish" ]; then
            dst="$HOME/.config/fish/$filename"
        elif [ "$topic" = "gh" ]; then
            dst="$HOME/.config/gh/$filename"
        else
            dst="$HOME/$filename"
        fi
        link_file "$src" "$dst"
    done
}

install_fisher_plugins() {
    run_if_available fish "fisher plugin install" fish -c "
        if not functions -q fisher
            curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
            fisher install jorgebucaran/fisher
        end
        fisher update
    "
}

install_tmux_plugins() {
    command -v tmux &>/dev/null || return 0
    local tpm_dir="$HOME/.tmux/plugins/tpm"
    [ -d "$tpm_dir" ] || git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir" || echo "Warning: tpm clone failed, continuing…"
    [ -x "$tpm_dir/bin/install_plugins" ] && "$tpm_dir/bin/install_plugins" || echo "Warning: tmux plugin install failed, continuing…"
}

set_default_shell() {
    local fish_path="${1:-/opt/homebrew/bin/fish}"
    [ -x "$fish_path" ] || return 0
    "$fish_path" -c 'true' || { echo "Warning: fish check failed, not changing login shell"; return 0; }
    grep -qxF "$fish_path" /etc/shells || { echo "$fish_path" | sudo tee -a /etc/shells >/dev/null || echo "Warning: could not add fish to /etc/shells, continuing…"; }
    [ "$SHELL" = "$fish_path" ] || chsh -s "$fish_path" || echo "Warning: chsh to fish failed, continuing…"
}

main() {
    install_homebrew
    install_deps
    install_npm_globals
    install_uv_tools
    install_antigravity
    create_symlinks
    install_fisher_plugins
    install_tmux_plugins
    set_default_shell
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main
fi
