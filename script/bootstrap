#!/usr/bin/env bash
set -e

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

link_file() {
    local src="$1" dst="$2"
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then return; fi
    if [ -f "$dst" ] || [ -d "$dst" ] || [ -L "$dst" ]; then
        mv "$dst" "${dst}.backup"
    fi
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    echo "linked: $dst → $src"
}

install_homebrew() {
    command -v brew &>/dev/null && return
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
}

install_deps() {
    local brewfile="$DOTFILES_ROOT/homebrew/Brewfile"
    [ -f "$brewfile" ] && brew bundle --adopt --file="$brewfile" || echo "Warning: some brew packages could not be installed, continuing…"
}

install_npm_globals() {
    command -v npm &>/dev/null || return
    npm install -g @deepseek-ai/dsh || echo "Warning: npm global install failed, continuing…"
}

install_uv_tools() {
    command -v uv &>/dev/null || return
    uv tool install git+https://github.com/github/spec-kit.git || echo "Warning: uv tool install failed, continuing…"
}

create_symlinks() {
    find "$DOTFILES_ROOT" -name "*.symlink" | while read -r src; do
        topic="$(basename "$(dirname "$src")")"
        filename="$(basename "$src" .symlink)"
        if [ "$topic" = "fish" ]; then
            dst="$HOME/.config/fish/$filename"
        elif [ "$topic" = "gh" ]; then
            dst="$HOME/.config/gh/$filename"
        else
            dst="$HOME/$filename"
        fi
        link_file "$src" "$dst"
    done
}

install_fisher_plugins() {
    command -v fish &>/dev/null || return
    fish -c "
        if not functions -q fisher
            curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
            fisher install jorgebucaran/fisher
        end
        fisher update
    " 2>/dev/null
}

install_tmux_plugins() {
    command -v tmux &>/dev/null || return
    local tpm_dir="$HOME/.tmux/plugins/tpm"
    [ -d "$tpm_dir" ] || git clone --depth 1 https://github.com/tmux-plugins/tpm "$tpm_dir"
    [ -x "$tpm_dir/bin/install_plugins" ] && "$tpm_dir/bin/install_plugins" || echo "Warning: tmux plugin install failed, continuing…"
}

set_default_shell() {
    local fish_path="/opt/homebrew/bin/fish"
    [ -x "$fish_path" ] || return
    "$fish_path" -c 'true' || { echo "Warning: fish check failed, not changing login shell"; return; }
    grep -qxF "$fish_path" /etc/shells || echo "$fish_path" | sudo tee -a /etc/shells >/dev/null
    [ "$SHELL" = "$fish_path" ] || chsh -s "$fish_path"
}

install_homebrew
install_deps
install_npm_globals
install_uv_tools
create_symlinks
install_fisher_plugins
install_tmux_plugins
set_default_shell
