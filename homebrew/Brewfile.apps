# ─── Optional apps ─────────────
# GUI applications kept on record but NOT installed by script/bootstrap.
# Install the whole set on a new machine with:
#
#   brew bundle --file=homebrew/Brewfile.apps
#
# or install one at a time with `brew install --cask <name>`.


# AI & LLM Tools
cask "claude"
cask "claude-code"   # CLI is already installed by script/bootstrap via npm; this is the standalone app
cask "google-gemini"
cask "ollama-app"
cask "chatgpt"

# IDEs & Code Editors
cask "visual-studio-code"
cask "zed"
cask "intellij-idea"
cask "pycharm-ce"

# Languages & SDKs
cask "temurin"
cask "temurin@21"
cask "flutter"

# Database & API Tools
cask "dbeaver-community"
cask "postman"
cask "bruno"
cask "db-browser-for-sqlite"

# Dev Infrastructure
cask "docker-desktop"
cask "antigravity-cli"

# Design, Media & Content Creation
cask "figma"
cask "canva"
cask "capcut"
cask "open-design"

# Communication
cask "discord"
cask "telegram"

# Productivity & Notes
cask "notion"
cask "obsidian"

# System Utilities & Misc
cask "betterdisplay"
cask "batfi"
cask "pearcleaner"
cask "vlc"
cask "spotify"
cask "keka"
cask "macusb"
