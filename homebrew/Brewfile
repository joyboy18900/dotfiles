# ─── Baseline GUI (Casks) ─────────────
# Only what a fresh machine needs to start developing: the terminal, its
# fonts, and browsers. Every other app lives in Brewfile.apps, which
# script/bootstrap never reads.

# Terminal
cask "wezterm"

# Fonts
cask "font-jetbrains-mono-nerd-font"
cask "font-hack-nerd-font"

# Browsers
