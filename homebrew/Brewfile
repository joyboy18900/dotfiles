# ─── Headless core ─────────────
# Cross-platform CLI baseline. Everything here installs the same way on
# macOS and Linux (Homebrew formulae). script/bootstrap installs this file.
# macOS GUI apps live in Brewfile.macos, which bootstrap never reads.

# Shell & Prompt
brew "fish"
brew "fisher"

# CLI Utilities & System Tools
brew "gh"
brew "btop"
brew "fastfetch"
brew "cloudflared"
brew "k6"
brew "redis"
brew "qwen-code"

# Containers
brew "docker"
brew "docker-compose"

# JavaScript / TypeScript
brew "node"
brew "pnpm"
brew "typescript"

# Python
brew "python@3.13"
brew "uv"

# Java (keg-only; java/env.fish points JAVA_HOME at openjdk@21)
brew "openjdk@21"
brew "openjdk"

# Other Languages & Build Tools
brew "go"
brew "rustup"
brew "maven"

# Editor & Terminal Environment
brew "vim"
brew "tmux"
